{
  "name": "flame1down-client",
  "productName": "Flame1Down - 1",
  "version": "1.0.0",
  "private": true,
  "description": "Flame1Down - 1 Windows 客户端",
  "author": "Flame1Down - 1",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/prepare.js && electron .",
    "dist": "node scripts/prepare.js && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "@fontsource/long-cang": "^5.3.0"
  },
  "build": {
    "appId": "com.flame1down.client",
    "productName": "Flame1Down - 1",
    "executableName": "Flame1Down",
    "copyright": "Flame1Down - 1 · 为爱发电，永不盈利",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui.html",
      "build/icon.png",
      "fonts/**",
      "default-server.json",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Flame1Down - 1",
      "uninstallDisplayName": "Flame1Down - 1",
      "artifactName": "Flame1Down-Setup-${version}.${ext}",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "differentialPackage": false
    },
    "publish": null,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  }
}
